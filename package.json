{
  "name": "@petercjl/taobao-search-product-form",
  "version": "0.1.0",
  "description": "Portable Taobao search-result product-form research skill and CLI",
  "type": "module",
  "bin": {
    "taobao-search-form": "bin/taobao-search-form.mjs"
  },
  "files": [
    "README.md",
    "requirements.txt",
    "bin/*.mjs",
    "src/*.mjs",
    "skill/taobao-search-product-form/SKILL.md",
    "skill/taobao-search-product-form/capabilities.json",
    "skill/taobao-search-product-form/agents/*.yaml",
    "skill/taobao-search-product-form/adapters/*.json",
    "skill/taobao-search-product-form/references/**/*.md",
    "skill/taobao-search-product-form/references/**/*.json",
    "skill/taobao-search-product-form/scripts/*.py",
    "skill/taobao-search-product-form/scripts/*.mjs"
  ],
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petercjl/taobao-search-product-form.git"
  },
  "homepage": "https://github.com/petercjl/taobao-search-product-form#readme",
  "bugs": {
    "url": "https://github.com/petercjl/taobao-search-product-form/issues"
  },
  "license": "UNLICENSED",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/",
    "tag": "latest"
  },
  "dependencies": {
    "@excel.js/exceljs": "^0.9.0"
  },
  "scripts": {
    "check": "node --check src/cli.mjs && node --check skill/taobao-search-product-form/scripts/clean_search_export.mjs",
    "test": "node --test test/*.test.mjs && node src/run-python-tests.mjs"
  }
}
